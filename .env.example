# ── SizhuAtelier server env ── copy to .env for local dev; set these in Railway for prod ──

# Stripe (TEST keys while developing — start with sk_test_… / pk_test_…)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Public origin for Stripe success/cancel redirects.
# On Railway this auto-falls back to RAILWAY_PUBLIC_DOMAIN; set explicitly to be safe.
PUBLIC_URL=https://sizhuatelier-shop-production.up.railway.app

# Currency for Stripe line items (ISO 4217, lowercase)
CURRENCY=eur

# ── Optional: order persistence (Railway Postgres plugin sets DATABASE_URL) ──
# DATABASE_URL=postgresql://user:pass@host:5432/db

# ── Accounts / Celestial Credits (needs DATABASE_URL too) ──
# Long random secret used to sign session cookies. Auth is disabled until set.
# Generate e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# SESSION_SECRET=change-me-to-a-long-random-string

# ── BaZi-Berechnung: FuFirE-Engine (eigene API) ──
# FUFIRE_API_URL=https://bafe-production.up.railway.app
# FUFIRE_API_KEY=ff_xxx
# FUFIRE_BAZI_STANDARD=TLST
# FUFIRE_BAZI_BOUNDARY=midnight

# ── Print-on-Demand: Gelato ──
# GELATO_API_KEY=xxx
# GELATO_ORDER_TYPE=draft   # draft = Operator bestätigt im Dashboard; order = vollautomatisch
# Eigenständiges langes Secret für POST /api/fulfillment/retry/:sessionId
# FULFILLMENT_RETRY_SECRET=change-me-to-an-independent-random-string

# ── Optional: confirmation emails via Resend (https://resend.com) ──
# RESEND_API_KEY=re_xxx
# ORDER_FROM_EMAIL=SizhuAtelier <orders@yourdomain>
# NEWSLETTER_FROM_EMAIL=SizhuAtelier <newsletter@yourdomain>   # double-opt-in + campaigns
# ORDER_NOTIFY_EMAIL=atelier@yourdomain   # where new-order notices go
